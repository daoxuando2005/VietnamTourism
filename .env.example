# Copy to .env.local for frontend development. VITE_* values are PUBLIC.
VITE_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
VITE_API_URL=http://localhost:8080/api/v1
# Enable only after the P0-02 migration and hosted SDK checks pass.
VITE_LEGACY_PRIVATE_PROFILES_ENABLED=false

# Service runtime: pass explicitly to Java/Compose; Vite does not load these for Java.
APP_ENV=local
PROFILE_PERSISTENCE_ENABLED=false
PROFILE_JDBC_URL=jdbc:postgresql://localhost:5432/profile
PROFILE_DB_USER=profile_runtime
PROFILE_DB_PASSWORD=REPLACE_LOCALLY
PROFILE_MIGRATION_USER=profile_migration
PROFILE_MIGRATION_PASSWORD=REPLACE_LOCALLY
SUPABASE_JWT_ISSUER=https://YOUR_TEST_PROJECT.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_TEST_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# P0-06 will wire JWT configuration after actual signing algorithm is verified.
